<UserControl x:Class="FileExplorer.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileExplorer.ViewModels"
             xmlns:models="clr-namespace:FileExplorer.Models"
             d:DataContext="{d:DesignInstance Type=vm:ExplorerTabViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False">

    <UserControl.Resources>

        <!-- Inline rename box, shown in place of the name when F2 is pressed. -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:FileSystemEntry}">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                           Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
                </StackPanel>

                <TextBox x:Name="RenameBox"
                         Text="{Binding Name, Mode=OneTime}"
                         Tag="{Binding}"
                         Padding="2,0"
                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                         KeyDown="OnRenameBoxKeyDown"
                         LostFocus="OnRenameBoxLostFocus"
                         IsVisibleChanged="OnRenameBoxVisibleChanged" />
            </Grid>
        </DataTemplate>

        <!-- x:Shared="False" hands out a fresh GridView per request; a GridView must never be
             attached to two ListViews, which happens as tabs are swapped in and out. -->
        <GridView x:Key="DetailsView" x:Shared="False"
                  ColumnHeaderContainerStyle="{StaticResource ExplorerColumnHeaderStyle}"
                  AllowsColumnReorder="False">
            <GridViewColumn Header="Name" Width="340"
                            CellTemplate="{StaticResource NameCellTemplate}" />
            <GridViewColumn Header="Date modified" Width="160"
                            DisplayMemberBinding="{Binding ModifiedText}" />
            <GridViewColumn Header="Type" Width="150"
                            DisplayMemberBinding="{Binding TypeName}" />
            <GridViewColumn Header="Size" Width="100"
                            DisplayMemberBinding="{Binding SizeText}" />
        </GridView>

        <!-- Icon views: thumbnail on top, wrapped caption below. -->
        <DataTemplate x:Key="IconItemTemplate" DataType="{x:Type models:FileSystemEntry}">
            <StackPanel Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource ThumbnailBoxSize}, ConverterParameter=44}">
                <Image Source="{Binding Icon}"
                       Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="{Binding Name}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}"
                               Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
                    <TextBox Text="{Binding Name, Mode=OneTime}" Tag="{Binding}" Padding="2,0"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                             KeyDown="OnRenameBoxKeyDown"
                             LostFocus="OnRenameBoxLostFocus"
                             IsVisibleChanged="OnRenameBoxVisibleChanged" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Compact single-column list, Explorer's "List" mode. -->
        <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type models:FileSystemEntry}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                       Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
                <Grid>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}"
                               Opacity="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
                    <TextBox Text="{Binding Name, Mode=OneTime}" Tag="{Binding}" Padding="2,0" MinWidth="160"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                             KeyDown="OnRenameBoxKeyDown"
                             LostFocus="OnRenameBoxLostFocus"
                             IsVisibleChanged="OnRenameBoxVisibleChanged" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="4" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <VirtualizingStackPanel Orientation="Vertical" IsItemsHost="True" />
        </ItemsPanelTemplate>

    </UserControl.Resources>

    <Grid>
        <ListView x:Name="FileList"
                  ItemsSource="{Binding Entries}"
                  SelectionMode="Extended"
                  Background="Transparent"
                  BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnItemDoubleClick"
                  PreviewKeyDown="OnListKeyDown"
                  PreviewMouseRightButtonDown="OnListRightButtonDown"
                  MouseRightButtonUp="OnListRightButtonUp"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnListLeftButtonDown"
                  PreviewMouseDown="OnListMouseDown"
                  MouseMove="OnListMouseMove"
                  DragOver="OnDragOver"
                  Drop="OnDrop">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="View" Value="{StaticResource DetailsView}" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource ExplorerListViewItemStyle}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIconView}" Value="True">
                            <Setter Property="View" Value="{x:Null}" />
                            <Setter Property="ItemTemplate" Value="{StaticResource IconItemTemplate}" />
                            <Setter Property="ItemContainerStyle" Value="{StaticResource ExplorerIconItemStyle}" />
                            <Setter Property="ItemsPanel" Value="{StaticResource WrapPanelTemplate}" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="View" Value="{x:Null}" />
                            <Setter Property="ItemTemplate" Value="{StaticResource ListItemTemplate}" />
                            <Setter Property="ItemContainerStyle" Value="{StaticResource ExplorerIconItemStyle}" />
                            <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
        </ListView>

        <!-- Empty folder / error / progress states, drawn over the list. -->
        <TextBlock Text="This folder is empty."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Entries.Count}" Value="0" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                <Condition Binding="{Binding HasError}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Background="{DynamicResource WindowBackgroundBrush}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="32" Text="&#xE7BA;"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding Error}" Margin="0,12,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
