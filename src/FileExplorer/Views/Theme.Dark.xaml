<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Windows 10 Explorer with the dark app mode: the same layout, with the near-black
        surfaces (#1F1F1F content, #2B2B2B chrome) and the muted blue selection the shell
        switches to when AppsUseLightTheme is 0.
    -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#5A5A5A" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7A7A7A" />

    <SolidColorBrush x:Key="HoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#264F78" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#3A6EA5" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2F5F8F" />

    <SolidColorBrush x:Key="FileTabBrush" Color="#2B579A" />
    <SolidColorBrush x:Key="FileTabHoverBrush" Color="#3C6BB5" />
    <SolidColorBrush x:Key="FileTabTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ProgressBrush" Color="#06B025" />

</ResourceDictionary>
